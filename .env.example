# ---------------------------------------------------------------------------
# Rangkhaneh environment variables. Copy to `.env.local` and fill in.
# NEVER commit real secrets. `.env*` is gitignored (except this example).
# ---------------------------------------------------------------------------

# --- Public: safe to expose to the browser -------------------------------
# Supabase project URL and anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# --- Server only: never exposed to the client ----------------------------
# Comma-separated list of email addresses allowed to sign in. This is the
# only way to gain access — there is no public signup.
AUTH_ALLOWLIST="you@example.com"

# Service-role key. Used ONLY by server-side admin scripts (e.g. seeding) and
# never imported into client code. Leave blank if you don't run admin scripts.
SUPABASE_SERVICE_ROLE_KEY=""

# Name of the private storage bucket for attachments.
SUPABASE_ATTACHMENTS_BUCKET="attachments"

# --- Dev seed (optional) -------------------------------------------------
# The seed script writes labelled EXAMPLE data owned by one user. Identify
# that user by email (looked up via the admin API) or by id directly.
# Requires SUPABASE_SERVICE_ROLE_KEY above.
SEED_OWNER_EMAIL="you@example.com"
# SEED_OWNER_ID=""

# --- E2E test configuration (optional) -----------------------------------
E2E_BASE_URL="http://localhost:3000"
E2E_TEST_EMAIL="you@example.com"
E2E_TEST_PASSWORD=""
# Set to 1 to test against an already-running server instead of `npm run start`.
# E2E_NO_SERVER="1"
