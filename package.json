{
  "name": "rangkhaneh",
  "version": "0.1.0",
  "private": true,
  "description": "Rangkhaneh — a private archive and argument workshop for the book project Colors of Iran.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "clsx": "2.1.1",
    "jszip": "3.10.1",
    "lucide-react": "0.454.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.53.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "16.4.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "^4",
    "tsx": "4.19.2",
    "typescript": "^5",
    "vitest": "2.1.5"
  }
}
